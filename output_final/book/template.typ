// Book template. Content files call the functions defined here.
// All speaker text is passed as string literals generated by script (never retyped);
// a string placed in content is rendered as plain text (no markup is interpreted).

#let c-other = rgb("#34414e")
#let c-src = rgb("#707070")
#let c-ref-bg = rgb("#eef3f7")
#let c-ref-line = rgb("#8fa9bf")
#let c-rule = rgb("#c4c4c4")
#let c-bar = rgb("#b8c2cc")

#let body-fonts = ("Source Serif 4", "Amiri", "Noto Naskh Arabic", "Noto Serif Hebrew", "DejaVu Sans", "FreeSerif", "WenQuanYi Zen Hei", "Noto Color Emoji")
#let arabic-fonts = ("Amiri", "Noto Naskh Arabic", "Source Serif 4", "DejaVu Sans")

// ---------- page furniture ----------
// Running header: the current chapter title, kept in a state that is cleared just before every
// part/chapter page break (so a chapter's first page has no header) and set after the chapter heading.
#let running = state("running-chapter", none)
#let running-header = context {
  let cur = running.get()
  if cur != none {
    set text(size: 8.4pt, fill: c-src)
    block(width: 100%, below: 0pt)[
      #emph(cur)
      #v(-4pt)
      #line(length: 100%, stroke: 0.4pt + c-rule)
    ]
  }
}

#let running-footer = context {
  set text(size: 9pt, fill: c-src)
  let bs = query(<body-start>)
  let in-body = bs.len() > 0 and here().page() >= bs.first().location().page()
  align(center)[#counter(page).display(if in-body { "1" } else { "i" })]
}

#let body-start() = {
  pagebreak(weak: true)
  counter(page).update(1)
  [#metadata("body") <body-start>]
}

// Index of sources: one group per channel, titles exactly as in the input.
#let source-group(channel, titles) = {
  heading(level: 2, channel)
  set par(justify: false, spacing: 0.55em, hanging-indent: 1.2em)
  set text(size: 9.6pt)
  for t in titles { block(width: 100%)[#t] }
}

#let book-setup(doc) = {
  set document(title: "The Muslim Lantern and Farid Responds: A Topical Compilation", author: ("The Muslim Lantern", "Farid Responds"))
  set page(paper: "a4", margin: (inside: 30mm, outside: 25mm, top: 28mm, bottom: 26mm), binding: left,
           header: running-header, footer: running-footer)
  set text(font: body-fonts, size: 11.2pt, lang: "en", hyphenate: true, fallback: true)
  set par(justify: true, leading: 0.8em, spacing: 0.9em, first-line-indent: 0pt)
  show heading: set text(font: body-fonts, hyphenate: false)
  show heading: set par(justify: false)
  show heading.where(level: 1): it => {
    running.update(none)
    pagebreak(weak: true)
    v(32%)
    align(center, block(width: 85%)[
      #set text(size: 25pt, weight: "semibold")
      #it.body
    ])
    pagebreak()
  }
  show heading.where(level: 2): it => {
    running.update(none)
    pagebreak(weak: true)
    v(10mm)
    block(width: 100%, below: 1.4em)[
      #set text(size: 19pt, weight: "semibold")
      #it.body
      #v(-0.35em)
      #line(length: 100%, stroke: 0.6pt + c-rule)
    ]
    running.update(it.body)
  }
  show heading.where(level: 3): it => {
    v(1.1em, weak: true)
    block(below: 0.9em, sticky: true)[
      #set text(size: 13pt, weight: "semibold", fill: rgb("#24323f"))
      #it.body
    ]
  }
  doc
}

// ---------- body elements ----------
// Host turn: label in bold, then the verbatim text split into paragraphs at segment boundaries.
#let host(label, paras) = {
  block(width: 100%, above: 0.85em, below: 0.85em, breakable: true)[
    #for (i, p) in paras.enumerate() {
      if i == 0 [#text(weight: "bold")[#label:]#h(0.35em)#p] else [#p]
      if i < paras.len() - 1 { parbreak() }
    }
  ]
}

// Guest / clip turn: indented, italic, with a left bar. `cut` = true when only the end of the turn is shown.
#let other(label, paras, cut: false) = {
  block(width: 100%, above: 0.75em, below: 0.75em, inset: (left: 1.1em, right: 0.6em, y: 0.15em),
        stroke: (left: 1.3pt + c-bar), breakable: true)[
    #set text(style: "italic", fill: c-other, size: 10.2pt)
    #for (i, p) in paras.enumerate() {
      if i == 0 [#text(weight: "bold")[#label:]#h(0.35em)#if cut [#text(fill: c-src, style: "normal")[\[…\]]#h(0.25em)]#p] else [#p]
      if i < paras.len() - 1 { parbreak() }
    }
  ]
}

#let source(s) = {
  block(width: 100%, above: 0.6em, below: 0.4em, sticky: false)[
    #set par(justify: false)
    #set text(size: 8.6pt, fill: c-src, style: "italic")
    #s
  ]
}

#let sep() = {
  v(0.5em)
  align(center, line(length: 18%, stroke: 0.5pt + c-rule))
  v(0.5em)
}

// Reference text box (section 3.1). items: array of (tag, text) pairs; tag may be "".
#let refbox(label, items, arabic: false) = {
  block(width: 100%, above: 0.7em, below: 0.9em, fill: c-ref-bg, inset: (x: 10pt, y: 8pt), radius: 2.5pt,
        stroke: (left: 2.2pt + c-ref-line), breakable: true)[
    #block(below: 0.55em)[#text(size: 8.2pt, weight: "semibold", fill: rgb("#4a6075"), tracking: 0.02em)[#label]]
    #set text(size: 9.8pt, style: "normal")
    #set par(spacing: 0.6em)
    #for (tag, t) in items {
      if arabic {
        set text(font: arabic-fonts, size: 12pt, lang: "ar", dir: rtl)
        set par(justify: true)
        block(width: 100%)[#t]
      } else {
        block(width: 100%)[#if tag != "" [#text(size: 8pt, fill: c-src, weight: "semibold")[#tag]#h(0.45em)]#t]
      }
    }
  ]
}

// ---------- articles (embedded original PDF pages, unaltered) ----------
// Each page of the original PDF is placed, scaled to fit, on its own book page.
#let article(label, src, path, npages) = {
  for p in range(1, npages + 1) {
    page(margin: (inside: 14mm, outside: 12mm, top: 22mm, bottom: 18mm))[
      #if p == 1 [#block(below: 2mm)[#text(weight: "bold")[#label:]]]
      #align(center + top, block(width: 100%, height: if p == 1 or p == npages { 236mm } else { 245mm })[
        #align(center, image(path, page: p, width: 100%, height: 100%, fit: "contain"))
      ])
      #if p == npages { source(src) }
    ]
  }
}

// A very wide single-page diagram: shown in overlapping landscape slices (view cropping only).
// ratio = page width / page height of the original.
#let wide-article(label, src, path, ratio, slices) = {
  let pw = 297mm - 24mm
  let ph = 210mm - 32mm - 12mm
  let w = ph * ratio
  let step = (w - pw) / (slices - 1)
  for i in range(slices) {
    page(flipped: true, margin: (x: 12mm, top: 20mm, bottom: 12mm))[
      #block(below: 2mm)[#if i == 0 [#text(weight: "bold")[#label:]] #h(1fr) #text(size: 8pt, fill: c-src)[(#(i + 1)/#slices)]]
      #block(width: pw, height: ph, clip: true)[
        #place(top + left, dx: -step * i, image(path, width: w, height: ph, fit: "stretch"))
      ]
      #if i == slices - 1 { source(src) }
    ]
  }
}
