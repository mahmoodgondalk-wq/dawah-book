// Template of the edited book. All passage text is passed as string literals generated by script from the
// edited files (the hosts' own words, deletion-only edited); a string placed in content is rendered as plain text.
#import "../book/template.typ": c-other, c-src, c-ref-bg, c-ref-line, c-rule, c-bar, body-fonts, arabic-fonts, running, running-header, running-footer, body-start, source-group, refbox, article, wide-article, source

#let book-setup(doc) = {
  set document(title: "The Muslim Lantern and Farid Responds: The Arguments", author: ("The Muslim Lantern", "Farid Responds"))
  set page(paper: "a4", margin: (inside: 30mm, outside: 25mm, top: 28mm, bottom: 26mm), binding: left,
           header: [#counter(footnote).update(0)#running-header], footer: running-footer)  // footnotes numbered per page
  set text(font: body-fonts, size: 11.2pt, lang: "en", hyphenate: true, fallback: true)
  set par(justify: true, leading: 0.8em, spacing: 0.75em, first-line-indent: 1.4em)
  set footnote.entry(separator: line(length: 30%, stroke: 0.4pt + c-rule), gap: 0.5em)
  show footnote.entry: set text(size: 8.4pt, fill: c-src)
  show footnote.entry: set par(justify: false, first-line-indent: 0pt)
  show heading: set text(font: body-fonts, hyphenate: false)
  show heading: set par(justify: false, first-line-indent: 0pt)
  show heading.where(level: 1): it => {
    running.update(none)
    pagebreak(weak: true)
    v(32%)
    align(center, block(width: 85%)[
      #set text(size: 25pt, weight: "semibold")
      #it.body
    ])
    pagebreak()
  }
  show heading.where(level: 2): it => {
    running.update(none)
    pagebreak(weak: true)
    counter(footnote).update(0)
    v(10mm)
    block(width: 100%, below: 1.4em)[
      #set text(size: 19pt, weight: "semibold")
      #it.body
      #v(-0.35em)
      #line(length: 100%, stroke: 0.6pt + c-rule)
    ]
    running.update(it.body)
  }
  show heading.where(level: 3): it => {
    v(1.3em, weak: true)
    block(below: 0.9em, sticky: true)[
      #set text(size: 13pt, weight: "semibold", fill: rgb("#24323f"))
      #it.body
    ]
  }
  doc
}

// Author line: shown when the author of the following passages changes inside a sub-chapter.
#let author(name) = {
  block(width: 100%, above: 1.0em, below: 0.5em, sticky: true)[
    #set par(first-line-indent: 0pt)
    #text(size: 9.2pt, weight: "semibold", fill: rgb("#4a6075"), tracking: 0.06em)[#upper(name)]
  ]
}

// One passage: paragraphs of the host's (edited) words. Every paragraph ends with a footnote giving the video
// (channel and title) and the time in the video where its words were spoken; the time links to the video at that
// moment. times: ((start second, "m:ss–m:ss"), ...), one per paragraph. A following paragraph of the same passage
// (same video) says "Ibid.", except when its footnote is the first one on a page.
#let passage(paras, src, url, times) = {
  for (i, p) in paras.enumerate() {
    let (sec, label) = times.at(i)
    let when = link(url + "&t=" + str(sec) + "s", label)
    [#p#context {
      let first-on-page = counter(footnote).get().first() == 0
      footnote(if i == 0 or first-on-page [#src, #when.] else [Ibid., #when.])
    }]
    if i < paras.len() - 1 { parbreak() }
  }
  parbreak()
  v(0.45em, weak: true)
}
