// Topic index of the videos: generated by work/scripts/topic_index.py (index.typ); this file only sets the layout.
#let c-rule = rgb("#b9c3cc")
#let c-src = rgb("#56606a")
#let c-link = rgb("#1f4e79")
#let setup(doc) = {
  set document(title: "Topic Index of the Videos — The Muslim Lantern and Farid Responds")
  set page(paper: "a4", margin: (x: 18mm, top: 20mm, bottom: 18mm),
           footer: context align(center, text(size: 8pt, fill: c-src, counter(page).display())))
  set text(font: ("Source Serif 4", "Amiri", "Noto Naskh Arabic", "DejaVu Sans", "FreeSerif", "WenQuanYi Zen Hei", "Noto Color Emoji"),
           size: 9.2pt, lang: "it", hyphenate: false, fallback: true)
  set par(justify: false, leading: 0.55em, spacing: 0.5em)
  show link: set text(fill: c-link)
  doc
}
#let part(num, title) = {
  pagebreak(weak: true)
  block(above: 0pt, below: 0.9em)[#text(size: 15pt, weight: "semibold")[Part #num. #title]]
}
#let chapter(num, title) = block(above: 1.1em, below: 0.5em, sticky: true)[
  #text(size: 12pt, weight: "semibold")[#num. #title]
  #v(-0.5em)
  #line(length: 100%, stroke: 0.5pt + c-rule)
]
#let sub(num, title) = block(above: 0.75em, below: 0.35em, sticky: true)[
  #text(size: 10pt, weight: "semibold", fill: rgb("#24323f"))[#num #title]
]
#let video(channel, title, url, times) = block(above: 0.25em, below: 0.25em, inset: (left: 1em))[
  #text(fill: c-src, size: 8.4pt)[#channel] — “#title” — #times.map(((sec, label)) => link(url + "&t=" + str(sec) + "s", label)).join(", ")
]
#let article-entry(title) = block(above: 0.25em, below: 0.25em, inset: (left: 1em))[
  #text(fill: c-src, size: 8.4pt)[Farid Responds] — articolo scritto: “#title” (riprodotto nel libro)
]
